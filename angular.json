{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "trincosynergy-angular": {
      "projectType": "application",
      "schematics": {"@schematics/angular:component": {"style": "css"}},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/trincosynergy-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {"glob": "**/*", "input": "images", "output": "/images"},
              {"glob": "**/*", "input": "Icons", "output": "/Icons"}
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {"budgets": [{"type": "initial", "maximumWarning": "2MB", "maximumError": "5MB"}], "outputHashing": "all"},
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"production": {"buildTarget": "trincosynergy-angular:build:production"}, "development": {"buildTarget": "trincosynergy-angular:build:development"}}, "defaultConfiguration": "development"}
      }
    }
  }
}
